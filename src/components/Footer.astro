---
import { site } from '../data/site';
import Icon from './Icon.astro';

const links = [
  { label: 'GitHub', icon: 'github', href: site.github },
  { label: 'LinkedIn', icon: 'linkedin', href: site.linkedin },
  { label: 'Email', icon: 'email', href: `mailto:${site.email}` },
] as const;

// Evaluated at build time, so it updates on every deploy
const year = new Date().getFullYear();
---

<footer class="footer is-dark">
  <div class="container footer__inner">
    <p>© {year} {site.name}</p>

    <ul class="footer__links" aria-label="Social links">
      {
        links.map((link) => (
          <li>
            <a class="footer__link" href={link.href}>
              <Icon name={link.icon} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="footer__top" href="/#home">Back to top</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-lg);
    background: var(--color-navy);
    color: var(--color-text-on-dark-muted);
    font-size: 0.9375rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer a {
    text-underline-offset: 0.25em;
    transition: color var(--transition);
  }

  .footer a:hover {
    color: var(--color-white);
  }
</style>
