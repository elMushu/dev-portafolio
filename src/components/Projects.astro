---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section
  id="projects"
  class="section section--divided"
  aria-labelledby="projects-title"
>
  <div class="container">
    <p class="section-label" aria-hidden="true">03</p>
    <h2 id="projects-title" class="section-title">Projects</h2>
    <p class="projects__intro">
      Independent projects, focused on backend engineering. My professional work
      is covered in Experience.
    </p>

    <div class="projects__grid">
      {
        projects.length > 0 ? (
          projects.map((project) => <ProjectCard project={project} />)
        ) : (
          <article class="loading">
            <p class="mono-label">Next project</p>
            <p class="loading__title">Loading…</p>
            <p>
              A backend-focused personal project will live here, documented with
              its architecture, API design, tests and lessons learned.
            </p>

            {/* Decorative skeleton, hidden from assistive technology */}
            <div class="skeleton" aria-hidden="true">
              <span class="skeleton__line skeleton__line--wide"></span>
              <span class="skeleton__line"></span>
              <span class="skeleton__line skeleton__line--short"></span>
            </div>
          </article>
        )
      }
    </div>
  </div>
</section>

<style>
  .projects__intro {
    max-width: 40rem;
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
  }

  /* auto-fill keeps each card a sensible width even when there is only one */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .loading {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px dashed var(--color-text-muted);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .loading__title {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }

  .skeleton {
    display: grid;
    gap: 0.625rem;
    margin-top: var(--space-xs);
  }

  .skeleton__line {
    display: block;
    width: 80%;
    height: 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-border);
  }

  .skeleton__line--wide {
    width: 100%;
  }

  .skeleton__line--short {
    width: 55%;
  }

  /* Gentle pulse, only for people who have not asked for reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .skeleton__line {
      animation: pulse 1.8s ease-in-out infinite;
    }

    .skeleton__line:nth-child(2) {
      animation-delay: 0.2s;
    }

    .skeleton__line:nth-child(3) {
      animation-delay: 0.4s;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }
</style>
