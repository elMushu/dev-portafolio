---
// Source: CLAUDE.md (portfolio context) and resume (CV.pdf)
const paragraphs = [
  "Backend Software Engineer with nearly 3 years of professional experience building Java and Spring Boot services in the financial sector. At Banregio / Hey Banco, the work centered on microservices, REST APIs and internal automation tools, with a steady focus on testing, code quality and production support.",
  "The path began in 2019 as a part-time developer intern at Universidad de Montemorelos, on Java and Spring systems that included the university's Academic System, used daily by students, professors and administrative staff. Backend engineering became the direction there. A Front-End internship at OneCard added hands-on experience with REST APIs, SQL and transaction monitoring in a fintech environment, before the move into backend engineering at Banregio / Hey Banco.",
  "Maintainable, well-tested backend code matters to me, and so does understanding the reasons behind technical decisions. Next on the list: growing my knowledge of software architecture and taking on more ownership of end-to-end backend solutions.",
];

const hobbies = ['Tennis', 'Gym', 'Reading', 'Movies'];

const facts = [
  {
    term: 'Education',
    details: [
      'B.S. in Computer Systems Engineering',
      'Universidad de Montemorelos',
    ],
  },
  {
    term: 'Languages',
    details: ['Spanish: Native', 'English: B2 (Upper-Intermediate)'],
  },
];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <p class="section-label" aria-hidden="true">01</p>
    <h2 id="about-title" class="section-title">About</h2>

    <div class="about__grid">
      <div class="about__text">
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>

      <div class="about__side">
        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="facts__item">
                <dt>{fact.term}</dt>
                {fact.details.map((detail) => (
                  <dd>{detail}</dd>
                ))}
              </div>
            ))
          }
        </dl>

        <aside class="beyond" aria-labelledby="beyond-title">
          <h3 id="beyond-title" class="beyond__title">Beyond Code</h3>
          <ul class="beyond__list">
            {hobbies.map((hobby) => <li>{hobby}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .about__grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .about__text {
    display: grid;
    gap: var(--space-sm);
    max-width: 40rem;
  }

  .about__side {
    display: grid;
    gap: var(--space-md);
  }

  .facts {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .facts__item {
    display: grid;
    gap: 0.15rem;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: 0;
  }

  .beyond {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .beyond__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .beyond__list {
    display: grid;
    gap: 0.75rem;
    margin-top: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  /* Small green square as a list marker: the only accent in this section */
  .beyond__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .beyond__list li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-green);
  }
</style>
