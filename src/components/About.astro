---
// Wording comes from docs/portfolio-text.md (the approved final text). Keep the two in sync.
const paragraphs = [
  'Backend Software Engineer with 2.5+ years in banking (Banregio / Hey Banco), building Java and Spring Boot microservices, REST APIs, and internal automation tools used by 100–200 developers, with hands-on production support and AI-assisted engineering.',
  "The path began in 2019 with a part-time internship at Universidad de Montemorelos, on systems used every day by students, faculty, and staff. Backend work became the direction there. A part-time Front-End internship at OneCard followed, bringing REST APIs, SQL and transaction monitoring into the picture. Then came Banregio / Hey Banco: first as an intern, then as a Junior Backend Developer.",
  'Building with Java and Spring since 2019, with a focus on code that is easy to maintain and well tested. The next step is growing within an international, English-speaking engineering team.',
];

const hobbies = [
  { label: 'Tennis', emoji: '🎾' },
  { label: 'Gym', emoji: '🏋️' },
  { label: 'Reading', emoji: '📚' },
  { label: 'F1', emoji: '🏎️' },
];

const facts = [
  {
    term: 'Education',
    details: [
      'B.S. in Computer Systems Engineering',
      'Universidad de Montemorelos',
      'Aug 2019 – May 2024 · GPA 9.09/10',
    ],
  },
  {
    term: 'Languages',
    details: ['Spanish: Native', 'English: B2 (Upper-Intermediate)'],
  },
];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <p class="section-label" aria-hidden="true">01</p>
    <h2 id="about-title" class="section-title">About</h2>

    <div class="about__grid">
      <div class="about__text reveal">
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>

      <div class="about__side reveal">
        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="facts__item">
                <dt>{fact.term}</dt>
                {fact.details.map((detail) => (
                  <dd>{detail}</dd>
                ))}
              </div>
            ))
          }
        </dl>

        <aside class="hobbies" aria-labelledby="hobbies-title">
          <h3 id="hobbies-title" class="hobbies__title">Hobbies</h3>
          <ul class="hobbies__list">
            {
              hobbies.map((hobby) => (
                <li>
                  <span class="hobbies__emoji" aria-hidden="true">
                    {hobby.emoji}
                  </span>
                  {hobby.label}
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .about__grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .about__text {
    display: grid;
    gap: var(--space-sm);
    max-width: 40rem;
  }

  .about__side {
    display: grid;
    gap: var(--space-md);
  }

  .facts {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .facts__item {
    display: grid;
    gap: 0.15rem;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: 0;
  }

  .hobbies {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .hobbies__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-heading);
  }

  .hobbies__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .hobbies__list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  /* Emoji bounces a little when its hobby is hovered */
  .hobbies__emoji {
    display: inline-block;
    transition: transform var(--transition);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hobbies__list li:hover .hobbies__emoji {
      transform: translateY(-3px) scale(1.2);
    }
  }
</style>
