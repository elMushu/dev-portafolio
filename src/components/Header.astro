---
import { site, navLinks } from '../data/site';
---

<header class="site-header is-dark">
  <div class="container site-header__inner">
    {/* Looks like code. The visible mark is hidden from screen readers, which get the real name. */}
    <a class="brand" href="/#home">
      <span class="brand__mark" aria-hidden="true">
        <span class="brand__bracket brand__bracket--open">&lt;</span>EJ<span
          class="brand__bracket brand__bracket--close">&gt;</span
        >
      </span>
      <span class="visually-hidden">{site.name}, home</span>
    </a>

    {/* Both buttons stay hidden until the script below runs, so the page still works without JavaScript.
        DOM order matches the visual order, so Tab follows what you see. */}
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      Menu
    </button>


    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Switch to light theme">
      <span class="theme-toggle__icon" aria-hidden="true">☀️</span>
    </button>
  </div>

  {/* Reading progress: a green line grows along the bottom of the header as you scroll,
      with a tennis ball rolling at its tip. Decorative, so hidden from assistive technology. */}
  <div class="scroll-progress" aria-hidden="true">
    <span class="scroll-progress__line"></span>
    <svg class="scroll-progress__ball" viewBox="0 0 32 32">
      <defs>
        <clipPath id="progress-ball-clip"><circle cx="16" cy="16" r="14"></circle></clipPath>
      </defs>
      <circle cx="16" cy="16" r="15" fill="#b7d83d" stroke="#0b1f33" stroke-width="1.5"></circle>
      <g clip-path="url(#progress-ball-clip)" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
        <path d="M2 8C11 12 11 20 2 24"></path>
        <path d="M30 8C21 12 21 20 30 24"></path>
      </g>
    </svg>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-navy);
    color: var(--color-white);
    border-bottom: 1px solid var(--color-border-on-dark);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-md);
    min-height: var(--header-height);
  }

  .brand {
    text-decoration: none;
  }

  .brand__mark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand__bracket {
    display: inline-block;
    color: var(--color-green);
    transition: transform var(--transition);
  }

  /* On hover the brackets open up a little */
  .brand:hover .brand__bracket--open {
    transform: translateX(-3px);
  }

  .brand:hover .brand__bracket--close {
    transform: translateX(3px);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--color-text-on-dark-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    /* Green underline that grows from the left on hover */
    background: linear-gradient(var(--color-green), var(--color-green)) no-repeat
      left bottom / 0 2px;
    transition:
      color var(--transition),
      background-size var(--transition);
  }

  .nav a:hover {
    color: var(--color-white);
    background-size: 100% 2px;
  }

  /* Visual order. Mobile: brand, then Menu and the theme button on the right, nav list below.
     Desktop: brand, nav, theme button. The DOM already follows this order. */
  .brand {
    order: 1;
  }

  .nav-toggle {
    order: 2;
    margin-left: auto;
  }

  .theme-toggle {
    order: 3;
  }

  .nav {
    order: 4;
  }

  @media (min-width: 56rem) {
    .nav {
      order: 2;
      margin-left: auto;
    }
  }

  .theme-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--transition);
  }

  .site-header[data-theme-ready] .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    border-color: var(--color-white);
  }

  .theme-toggle__icon {
    display: inline-block;
    font-size: 1.125rem;
    line-height: 1;
    transition: transform var(--transition);
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle:hover .theme-toggle__icon {
      transform: rotate(20deg) scale(1.15);
    }
  }

  .nav-toggle {
    display: none;
    min-height: 2.75rem;
    padding: 0 var(--space-sm);
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--transition);
  }

  .nav-toggle:hover {
    border-color: var(--color-white);
  }

  /* Collapsible menu below the desktop breakpoint, only once JS has enhanced the header */
  @media (max-width: 55.99rem) {
    .site-header[data-enhanced] .nav-toggle {
      display: inline-flex;
      align-items: center;
    }

    .site-header[data-enhanced] .nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: var(--space-sm);
    }

    .site-header[data-enhanced][data-open] .nav {
      display: block;
    }

    .site-header[data-enhanced] .nav__list {
      flex-direction: column;
    }
  }

  /* Scroll progress. A script writes --progress (0 to 1) as you scroll; the CSS turns it into the
     green line and the rolling ball. Hidden until the script runs, and when motion is reduced.
     (A CSS-only version with animation-timeline does not work in Firefox or older Safari, and the
     build's CSS minifier also rewrites it into a shorthand Chrome rejects.) */
  .scroll-progress {
    display: none;
  }

  .site-header[data-progress-ready] .scroll-progress {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px; /* sits on the header's bottom border */
    height: 2px;
    pointer-events: none;
  }

  .scroll-progress__line {
    display: block;
    height: 100%;
    background: var(--color-green);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  /* Rolls from the left edge to the right edge, spinning as it goes */
  .scroll-progress__ball {
    position: absolute;
    top: 50%;
    left: calc(0.5rem + var(--progress, 0) * (100% - 1rem));
    width: 1rem;
    height: 1rem;
    margin: -0.5rem 0 0 -0.5rem;
    rotate: calc(var(--progress, 0) * 1440deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = header?.querySelector<HTMLElement>('.nav');
  const themeButton = header?.querySelector<HTMLButtonElement>('.theme-toggle');

  // Scroll progress: sets --progress (0 at the top, 1 at the bottom) for the line and the ball
  const progress = header?.querySelector<HTMLElement>('.scroll-progress');
  if (
    header &&
    progress &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    header.setAttribute('data-progress-ready', '');
    let waiting = false;

    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      progress.style.setProperty('--progress', value.toFixed(4));
      waiting = false;
    };

    // At most one update per frame
    const onScroll = () => {
      if (!waiting) {
        waiting = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  // Theme switch: dark is the default, light is remembered in localStorage
  if (header && themeButton) {
    const root = document.documentElement;
    const icon = themeButton.querySelector('.theme-toggle__icon');

    const render = () => {
      const isDark = root.dataset.palette !== 'light';
      themeButton.setAttribute(
        'aria-label',
        isDark ? 'Switch to light theme' : 'Switch to dark theme',
      );
      // The icon shows the theme you would switch to
      if (icon) icon.textContent = isDark ? '☀️' : '🌙';
    };

    header.setAttribute('data-theme-ready', '');
    render();

    themeButton.addEventListener('click', () => {
      const next = root.dataset.palette === 'light' ? 'dark' : 'light';
      root.dataset.palette = next;
      try {
        localStorage.setItem('palette', next);
      } catch (error) {
        // Blocked storage: the choice just won't survive a reload
      }
      render();
    });
  }

  if (header && toggle && nav) {
    header.setAttribute('data-enhanced', '');

    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close after choosing a link
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset when the viewport grows to the desktop layout
    window
      .matchMedia('(min-width: 56rem)')
      .addEventListener('change', () => setOpen(false));
  }
</script>
