---
import ExperienceCard from './ExperienceCard.astro';
import TechTag from './TechTag.astro';
import { jobs } from '../data/experience';

// Case studies are numbered across the whole section (01, 02, 03...) so each identifier is unique
let counter = 0;
const items = jobs.map((job) => ({
  ...job,
  studies: job.caseStudies.map((study) => ({
    study,
    number: String(++counter).padStart(2, '0'),
  })),
}));
---

<section
  id="experience"
  class="section section--divided"
  aria-labelledby="experience-title"
>
  <div class="container">
    <p class="section-label" aria-hidden="true">02</p>
    <h2 id="experience-title" class="section-title">Experience</h2>
    <p class="experience__intro">
      Professional work, most recent first, with selected case studies.
    </p>

    <ol class="jobs">
      {
        items.map((job) => (
          <li class="job reveal">
            <div class="job__info">
              <h3 class="job__company">{job.company}</h3>
              <p class="job__location">{job.location}</p>
              {job.workMode && <p class="job__mode">{job.workMode}</p>}
              {job.industry && <p class="job__industry">{job.industry}</p>}

              <ul class="job__positions">
                {job.positions.map((position) => (
                  <li>
                    <span class="job__title">{position.title}</span>
                    <span class="job__period">{position.period}</span>
                  </li>
                ))}
              </ul>

              {job.summary && <p>{job.summary}</p>}

              {job.technologies && (
                <ul class="tag-list" aria-label="Technologies and tools">
                  {job.technologies.map((tech) => (
                    <TechTag label={tech} />
                  ))}
                </ul>
              )}
            </div>

            <div class="job__details">
              {job.highlights && (
                <div class="highlights">
                  <p class="mono-label">Key contributions</p>
                  <dl class="highlights__list">
                    {job.highlights.map((group) => (
                      <div class="highlights__group">
                        <dt>{group.theme}</dt>
                        {group.items.map((item) => (
                          <dd>{item}</dd>
                        ))}
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {job.studies.map(({ study, number }) => (
                <ExperienceCard study={study} number={number} />
              ))}

              {job.growth && (
                <div class="growth">
                  <p class="mono-label">Professional growth</p>
                  <p>{job.growth}</p>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience__intro {
    max-width: 40rem;
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
  }

  .jobs {
    display: grid;
    gap: var(--space-xl);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .job {
    display: grid;
    gap: var(--space-lg);
  }

  .job + .job {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 56rem) {
    .job {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-xl);
      align-items: start;
    }

  }

  /* Company info stays in view while its details scroll. Only on tall screens:
     a sticky block taller than the viewport would get cut off. */
  @media (min-width: 56rem) and (min-height: 45rem) {
    .job__info {
      position: sticky;
      top: calc(var(--header-height) + var(--space-md));
    }
  }

  .job__info {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .job__company {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }

  .job__location {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .job__positions {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-xs) 0;
    padding: 0;
    list-style: none;
  }

  .job__positions li {
    display: grid;
  }

  .job__title {
    font-weight: 600;
  }

  .job__period {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-muted);
  }

  .job__details {
    display: grid;
    gap: var(--space-md);
  }

  .job__mode {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .job__industry {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-muted);
  }

  .growth {
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .highlights__list {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-sm) 0 0;
  }

  .highlights__group {
    display: grid;
    gap: 0.25rem;
  }

  /* Theme title with the same small green square marker as "Beyond Code" */
  .highlights__list dt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    color: var(--color-heading);
  }

  .highlights__list dt::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-green);
  }

  .highlights__list dd {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
