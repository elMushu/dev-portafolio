---
import { techIcons } from '../data/techIcons';

interface Props {
  label: string;
}

const { label } = Astro.props;
// Labels without a logo (SQL Server, Mockito...) simply render as plain text chips
const icon = techIcons[label];
---

<li class="tag tech-tag">
  {
    icon && (
      <svg viewBox={icon.viewBox} fill="currentColor" aria-hidden="true" focusable="false">
        {icon.paths.map((d) => (
          <path d={d} />
        ))}
      </svg>
    )
  }
  {label}
</li>

<style>
  .tech-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  svg {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
