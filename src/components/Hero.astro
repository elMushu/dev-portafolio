---
import { site } from '../data/site';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/jazer-torres-portrait.jpg';

const intro =
  'Nearly 3 years building Java and Spring Boot microservices in banking technology, with a focus on process automation, software quality and maintainable code.';

const focusAreas = ['Java', 'Spring Boot', 'Microservices'];

const links = [
  { label: 'GitHub', icon: 'github', href: site.github },
  { label: 'LinkedIn', icon: 'linkedin', href: site.linkedin },
  { label: 'Email', icon: 'email', href: `mailto:${site.email}` },
] as const;

// Tennis court seen from above (real proportions: 78 x 36 units). Drawn as thin lines.
const courtLines = [
  [0, 45, 780, 45],
  [0, 315, 780, 315],
  [390, 0, 390, 360],
  [180, 45, 180, 315],
  [600, 45, 600, 315],
  [180, 180, 600, 180],
];
---

<section id="home" class="hero is-dark" aria-labelledby="hero-title">
  {/* Decorative: faint white court lines that draw themselves once on load */}
  <svg class="court" viewBox="0 0 780 360" aria-hidden="true" focusable="false">
    <rect class="court__line" style="--i: 0" x="0" y="0" width="780" height="360" pathLength="1"></rect>
    {
      courtLines.map(([x1, y1, x2, y2], index) => (
        <line
          class="court__line"
          style={`--i: ${index + 1}`}
          x1={x1}
          y1={y1}
          x2={x2}
          y2={y2}
          pathLength="1"
        />
      ))
    }
  </svg>

  <div class="container hero__grid">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">{site.name}</h1>
      <p class="hero__role">{site.role}</p>
      <p class="hero__location"><span class="nowrap">{site.location} ·</span> <span class="nowrap">{site.availability}</span></p>

      <ul class="hero__focus" aria-label="Professional focus">
        {focusAreas.map((area) => <li>{area}</li>)}
      </ul>

      <p class="hero__intro">{intro}</p>

      <div class="hero__actions">
        <a class="button button--primary" href={site.resume} download>
          Download CV
          <span class="button__icon" aria-hidden="true">↓</span>
        </a>
      </div>

      <ul class="hero__links" aria-label="Contact links">
        {
          links.map((link) => (
            <li>
              <a class="button button--outline" href={link.href}>
                <span class="hero__icon">
                  <Icon name={link.icon} />
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__media">
      {/* Above the fold, so it loads eagerly. Astro resizes it and serves WebP; the original in
          src/assets is never published. widths cover 1x to 4x of the 22rem card (352px),
          so the photo stays sharp on retina screens and when the visitor zooms in. The browser
          only downloads the one it needs. */}
      <div class="portrait">
        <Image
          src={portrait}
          alt="Portrait of Jazer Torres wearing a navy pinstripe suit and a burgundy tie"
          width={704}
          height={880}
          widths={[352, 704, 1056, 1408]}
          sizes="22rem"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden; /* the court is bigger than the hero on purpose */
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
    background: var(--color-navy);
    color: var(--color-white);
    border-bottom: 1px solid var(--dark-divider);
  }

  /* Court lines sit behind the content, anchored to the bottom right */
  .court {
    position: absolute;
    right: -4rem;
    bottom: -3rem;
    width: min(62rem, 130%);
    fill: none;
    stroke: var(--color-white);
    stroke-width: 2;
    opacity: 0.12;
    pointer-events: none;
    /* Fade toward the text so the lines never cross it */
    mask-image: linear-gradient(to left, #000 30%, transparent 80%);
  }

  .court__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .court__line {
      stroke-dashoffset: 1;
      animation: draw-line 2.2s ease-out forwards;
      animation-delay: calc(var(--i) * 0.3s);
    }
  }

  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero__grid {
    position: relative; /* above the court */
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: 3fr 2fr; /* text ~60%, photo ~40% */
    }
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__role {
    margin-top: var(--space-xs);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 600;
    color: var(--color-green);
  }

  .hero__location {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-on-dark-muted);
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    padding: 0;
    list-style: none;
  }

  .hero__focus li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .hero__intro {
    max-width: 38rem;
    margin-top: var(--space-md);
    color: var(--color-text-on-dark-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-lg);
  }

  /* Secondary buttons, in a row right under "Download CV" */
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .hero__links .button {
    gap: 0.5rem;
  }

  /* Logos follow the button text color; they give a little hop on hover */
  .hero__icon {
    display: inline-flex;
    transition: transform var(--transition);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__links a:hover .hero__icon {
      transform: translateY(-3px) scale(1.15);
    }
  }

  /* Portrait frame: the photo with a green outline offset behind it */
  .hero__media {
    isolation: isolate; /* keeps the ::before layer inside this component */
  }

  .portrait {
    --offset: clamp(0.5rem, 2vw, 1rem);
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 2px solid var(--color-green);
    border-radius: var(--radius-md);
    transform: translate(var(--offset), var(--offset));
  }

  /* The <img> lives inside the Image component, so it needs :global to be reached.
     Rounded here, not with overflow:hidden on the frame, which would also clip the green outline. */
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%; /* keeps the face in frame if the box ever crops */
    border-radius: var(--radius-md);
  }

  /* Entrance: each piece of the hero text rises into place, one after another.
     "backwards" means the animation only controls the element before it starts, so hover
     effects keep working afterwards. The portrait is left out on purpose: it is the largest
     element on the page and should appear as soon as it is ready. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__content > * {
      animation: rise 0.6s ease-out backwards;
    }

    .hero__content > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .hero__content > :nth-child(3) {
      animation-delay: 0.16s;
    }

    .hero__content > :nth-child(4) {
      animation-delay: 0.24s;
    }

    .hero__content > :nth-child(5) {
      animation-delay: 0.32s;
    }

    .hero__content > :nth-child(6) {
      animation-delay: 0.4s;
    }

    .hero__content > :nth-child(7) {
      animation-delay: 0.48s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
