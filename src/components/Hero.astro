---
import { site } from '../data/site';

// TODO: review copy. This draft only restates the profile; rewrite it in your own voice.
const intro =
  'I design and build backend systems with Java and Spring Boot, with a focus on microservices and distributed architectures.';

const focusAreas = ['Java Backend', 'Spring Boot', 'Distributed Systems'];
---

<section id="home" class="hero is-dark" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">{site.name}</h1>
      <p class="hero__role">{site.role}</p>

      <ul class="hero__focus" aria-label="Professional focus">
        {focusAreas.map((area) => <li>{area}</li>)}
      </ul>

      <p class="hero__intro">{intro}</p>

      <div class="hero__actions">
        <a class="button button--primary" href="/#experience">View Experience</a>
        <a class="button button--outline" href="/#projects">View Projects</a>
        <a class="button button--outline" href={site.resume} download>
          Download CV
        </a>
      </div>

      <ul class="hero__links" aria-label="Contact links">
        <li><a href={site.github}>GitHub</a></li>
        <li><a href={site.linkedin}>LinkedIn</a></li>
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </div>

    <div class="hero__media">
      {/* TODO: replace this placeholder with the real portrait (src/assets + astro:assets <Image>).
          The white photo background works as-is: the white card is the photo frame. */}
      <div class="portrait">
        <p class="portrait__note">Portrait placeholder</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
    background: var(--color-navy);
    color: var(--color-white);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: 3fr 2fr; /* text ~60%, photo ~40% */
    }
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__role {
    margin-top: var(--space-xs);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 600;
    color: var(--color-green);
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    padding: 0;
    list-style: none;
  }

  .hero__focus li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .hero__intro {
    max-width: 38rem;
    margin-top: var(--space-md);
    color: var(--color-text-on-dark-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-lg);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .hero__links a {
    color: var(--color-text-on-dark-muted);
    text-underline-offset: 0.25em;
    transition: color var(--transition);
  }

  .hero__links a:hover {
    color: var(--color-white);
  }

  /* Portrait frame: white card with a green outline offset behind it */
  .hero__media {
    isolation: isolate; /* keeps the ::before layer inside this component */
  }

  .portrait {
    --offset: clamp(0.5rem, 2vw, 1rem);
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 2px solid var(--color-green);
    border-radius: var(--radius-md);
    transform: translate(var(--offset), var(--offset));
  }

  .portrait__note {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-text-muted);
  }
</style>
