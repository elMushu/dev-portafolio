---
import { site } from '../data/site';
import Icon from './Icon.astro';

// Shows "linkedin.com/in/eryjazer" instead of the full URL
const readable = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const channels = [
  { label: 'Email', icon: 'email', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', icon: 'linkedin', value: readable(site.linkedin), href: site.linkedin },
  { label: 'GitHub', icon: 'github', value: readable(site.github), href: site.github },
  { label: 'Resume', icon: 'resume', value: 'Download PDF', href: site.resume },
] as const;
---

<section
  id="contact"
  class="section section--divided"
  aria-labelledby="contact-title"
>
  <div class="container">
    <p class="section-label" aria-hidden="true">04</p>
    <h2 id="contact-title" class="section-title">Contact Me</h2>

    {/* One panel with four cells: the 1px gaps show the border color between them */}
    <ul class="channels">
      {
        channels.map((channel) => (
          <li>
            <a class="channel" href={channel.href}>
              <span class="channel__head">
                <span class="channel__icon">
                  <Icon name={channel.icon} />
                </span>
                <span class="mono-label">{channel.label}</span>
              </span>
              <span class="channel__value">{channel.value}</span>
              <span class="channel__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-border);
  }

  /* Exactly 4 channels: 1 column, then 2x2, then a single row of 4 */
  @media (min-width: 40rem) {
    .channels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .channels {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Arrow appears in the corner on hover or keyboard focus */
  .channel__arrow {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-md);
    color: var(--color-navy);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity var(--transition),
      transform var(--transition);
  }

  .channel:hover .channel__arrow,
  .channel:focus-visible .channel__arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .channel {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-md);
    background: var(--color-white);
    text-decoration: none;
    transition: background-color var(--transition);
  }

  .channel:hover {
    background: var(--color-background);
  }

  .channel:hover .channel__value {
    text-decoration: underline;
    text-decoration-color: var(--color-green-hover);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .channel__head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .channel__icon {
    display: inline-flex;
    color: var(--color-navy);
    transition: transform var(--transition);
  }

  @media (prefers-reduced-motion: no-preference) {
    .channel:hover .channel__icon {
      transform: scale(1.15);
    }
  }

  .channel__value {
    font-weight: 600;
    color: var(--color-navy);
    overflow-wrap: anywhere;
  }

  /* Keep the focus ring inside the panel, where overflow:hidden would clip it */
  .channel:focus-visible {
    outline-offset: -3px;
  }
</style>
