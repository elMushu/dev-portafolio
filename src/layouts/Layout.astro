---
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/variables.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TechSprite from '../components/TechSprite.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  // Keeps a page out of search results (used by the 404 page)
  noindex?: boolean;
  // Person data for search engines. Only the home page needs it.
  structuredData?: boolean;
}

const { title, description, noindex = false, structuredData = true } = Astro.props;
// Uses `site` from astro.config.mjs (https://jazertorres.com) to build absolute URLs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const ogImageAlt = `${site.name}, ${site.role}, with a portrait on a navy background`;

// schema.org Person: helps Google understand who the site is about
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.fullName,
  jobTitle: site.role,
  url: Astro.site?.href,
  sameAs: [site.github, site.linkedin],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Montemorelos' },
  knowsAbout: ['Java', 'Spring Boot', 'Microservices', 'REST APIs'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B1F33" />

    {/* Icons: SVG for modern browsers, PNG fallbacks for the rest and for iOS home screens */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Social cards (LinkedIn, WhatsApp, Slack, X...) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    {/* Runs before the page paints, so someone who chose the light theme never sees a dark flash */}
    <script is:inline>
      try {
        if (localStorage.getItem('palette') === 'light') {
          document.documentElement.dataset.palette = 'light';
        }
      } catch (error) {
        /* Storage can be blocked. The site simply stays on the default dark theme. */
      }

      /* Sections start hidden only when JavaScript runs (the "js" class), then fade in on scroll.
         Safety net: if the reveal script below never starts, show everything after 3 seconds. */
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!document.documentElement.dataset.reveal) {
          document.documentElement.classList.add('no-reveal');
        }
      }, 3000);
    </script>
  </head>
  <body>
    <TechSprite />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade sections in the first time they scroll into view
      const items = document.querySelectorAll('.reveal');
      document.documentElement.dataset.reveal = 'ready';

      if (!('IntersectionObserver' in window)) {
        items.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
